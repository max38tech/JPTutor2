# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TURN_ANALYSIS_MODELS: comma-separated Gemini model fallback chain used to
# extract Japanese/Romaji/English from each live tutor turn. Optional -
# defaults to gemini-2.5-flash,gemini-2.0-flash,gemini-2.0-flash-lite.
# TURN_ANALYSIS_MODELS="gemini-2.5-flash,gemini-2.0-flash"

# LIVE_MODELS: comma-separated Gemini Live tutor model fallback chain, tried
# in order. Optional - defaults to
# gemini-3.1-flash-live-preview,gemini-2.0-flash-exp.
# LIVE_MODELS="gemini-3.1-flash-live-preview"

# TRANSCRIBE_MODELS: comma-separated dedicated transcription model fallback
# chain. The tutor model's own input transcription is unreliable, so a second
# Live session on a dedicated transcription model produces the authoritative
# user transcript. Optional - defaults to
# gemini-3.5-transcribe-live-preview,gemini-3.5-transcribe-live.
# TRANSCRIBE_MODELS="gemini-3.5-transcribe-live-preview"

# TRANSCRIBE_LANGUAGES: comma-separated BCP-47 language hints for the
# transcription model. The student speaks English and attempts Japanese.
# Optional - defaults to en-US,ja-JP.
# TRANSCRIBE_LANGUAGES="en-US,ja-JP"

# GITHUB_ISSUE_TOKEN: fine-grained GitHub PAT scoped to Issues:write on this
# repo only (nothing else). Required for the in-app "Report Bug" button to
# file a GitHub issue. Without it, that endpoint returns a clear 501 instead
# of failing silently.
# GITHUB_ISSUE_TOKEN="github_pat_..."

# GITHUB_REPO: owner/repo to file bug reports against. Optional - defaults
# to max38tech/JPTutor.
# GITHUB_REPO="max38tech/JPTutor"

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: required for the in-app "Feature
# Idea" button to log requests. Use the service_role key (server-side only,
# never sent to the client) - see supabase/schema.sql for the table this
# expects and why RLS is safe to leave with no policies.
# SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="..."

# QWEN_API_KEY: Alibaba Cloud DashScope key. When set, turn analysis tries
# Qwen FIRST (currently trialing it for quality vs. Gemini) and only falls
# back to Gemini if Qwen fails - remove this var to go back to Gemini-only.
# QWEN_BASE_URL defaults to the international (Singapore) OpenAI-compatible
# endpoint; QWEN_MODEL defaults to qwen3.7-flash.
# QWEN_API_KEY="sk-..."
# QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
# QWEN_MODEL="qwen3.7-flash"
